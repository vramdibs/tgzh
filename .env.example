# Уровень логов в stderr: DEBUG, INFO, WARNING, ERROR (бот и server.py)
LOG_LEVEL=INFO
# Макс. длина (символов) полей «ответ ученика» и «ответ модели» в логах /check и summarize (server.py, bot.py)
# CHECK_LOG_BODY_MAX_CHARS=16384

# --- Сеть (кратко) ---
# bot.py: обязателен исходящий HTTPS:443 до Telegram Bot API (обычно api.telegram.org) — см. README, раздел «Требования к сети»
# server.py: к Telegram не ходит; при AI_MOCK=0 нужен доступ к VLLM_BASE_URL
# «Показать ГДЗ» и разбор gdz.ru — исходящий HTTPS с процесса бота

# Токен бота от @BotFather
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Пароль для скрытой админ-команды /begemot (просмотр отзывов из /support). Пусто - команда отвечает, что раздел не настроен
# ADMIN_PASSWORD=

# Скрытая команда /chat — стриминговый ИИ-ассистент через Cursor (использует тот же
# fallback OpenAI-эндпоинт, что и проверка ДЗ). Пароль на вход; сессия живёт
# CHAT_SESSION_TTL_DAYS = 365 суток (см. user_storage.chat_session_*).
# Аналогично /begemot живёт ADMIN_SESSION_TTL_DAYS = 365 суток в таблице admin_session
# (миграция Alembic 012_admin_session) — повторный успешный ввод пароля продлевает окно,
# /begemot_logout закрывает сессию досрочно.
# Пусто CHAT_PASSWORD - используется ADMIN_PASSWORD; пусто и там - команда отвечает, что недоступна.
# CHAT_PASSWORD=
# CHAT_SYSTEM_PROMPT="Ты — дружелюбный школьный ИИ-ассистент. Отвечай по-русски..."
# Префикс CHAT_SAFETY_POLICY (ai_checker.py ≡ bot.py) навешивается ВСЕГДА поверх CHAT_SYSTEM_PROMPT;
# через env отключить нельзя. См. README — раздел «Политика /chat»: multimodal-вложения (в т.ч. пути
# /tmp/cursor-openai-sandbox/..., data:image/...), запрет shell/листинга чужих файлов, отказная фраза
# для произвольных действий на сервере, запрет мета-преамбул («сначала загружу инструкции» и т.п.).
# CHAT_MAX_HISTORY_TURNS=12      # сколько последних реплик user/assistant прокидывать в Cursor (2..64)
# CHAT_TEMPERATURE=0.7            # 0..2
# CHAT_MAX_RESPONSE_TOKENS=2048   # 128..8192
# Модели /chat (только без Fast, reasoning Low по slug). CSV — allowlist кнопок в боте:
# CHAT_CURSOR_MODELS=composer-2.5,cursor-grok-4.6-low
# CHAT_CURSOR_MODEL_DEFAULT=composer-2.5
# CHAT_CURSOR_MODEL_FALLBACK=cursor-grok-4.6-low   # авто-retry, если дефолт недоступен на bridge

# Долговременная «сон-память» в /chat (см. chat_memory.py + chat_memory_pref в БД).
# Каждому пользователю — каталог data/memory/<user_id>/ с MEMORY.md (индекс) и
# тематическими *.md (≤30 файлов, ≤8 КБ каждый, ≤25 КБ MEMORY.md, итого ≤150 КБ).
# По умолчанию память ВКЛЮЧЕНА; пользователь отключает кнопкой меню /chat
# («Память: вкл (выключить)») или просто не запускает /sleep — авто-сон тоже выключится.
# Сон — рефлексивный проход через POST /chat/once в Cursor-bridge: модель
# синтезирует свежие сигналы из последних реплик в файлы памяти.
# MEMORY_DIR_BASE=data/memory               # абсолютный или относительный путь
# CHAT_MEMORY_SLEEP_AFTER_MSGS=12           # порог авто-сна (1..200 user-реплик с прошлого сна)
# CHAT_MEMORY_SLEEP_MIN_GAP_SEC=600         # минимум секунд между двумя автоснами (0..86400)
# CHAT_MEMORY_SLEEP_TRANSCRIPT_TURNS=24     # сколько последних реплик подмешивать в sleep-промпт (2..64)
# CHAT_MEMORY_SLEEP_TIMEOUT_S=240           # клиентский таймаут одного sleep-вызова (30..600)

# Распознавание голосовых сообщений в /chat (см. stt_client.py).
# Контракт — OpenAI-совместимый POST /audio/transcriptions (Whisper API).
# Дефолт-стэка: docker compose поднимает локальный сервис tgzh-stt
# (hwdsl2/whisper-server, faster-whisper). Имя tgzh-stt резолвится только в
# compose-сети; для бота на хосте используй http://127.0.0.1:9100/v1.
# Чтобы выключить — оставь STT_BASE_URL пустым (или не задавай); бот вежливо
# сообщит, что распознавание не настроено. Для OpenAI:
# STT_BASE_URL=https://api.openai.com/v1, STT_API_KEY=sk-...
# STT_BASE_URL=http://tgzh-stt:9000/v1
# STT_API_KEY=
# STT_MODEL=whisper-1                       # whisper-server держит активную модель из WHISPER_MODEL
# STT_LANGUAGE=ru                           # или auto / en / ...
# STT_TIMEOUT_S=60                          # 5..600
# STT_MAX_AUDIO_BYTES=26214400              # 25 МБ; верх — 200 МБ

# Параметры локального tgzh-stt (compose читает через ${WHISPER_*}, см. docker-compose.yml).
# tiny ~75 МБ / base ~145 МБ / small ~465 МБ / medium ~1.5 ГБ / large-v3 / large-v3-turbo.
# small — оптимум по качеству русского при ~1.5 ГБ RAM в int8.
# WHISPER_MODEL=small
# WHISPER_LANGUAGE=ru                       # 'auto' — автоопределение языка
# WHISPER_DEVICE=cpu                        # cpu/cuda; на sm_120 (RTX 50xx) держим cpu
# WHISPER_COMPUTE_TYPE=int8                 # int8 для cpu; для cuda — float16
# WHISPER_THREADS=4                         # столько потоков, сколько физических ядер
# WHISPER_BEAM=1                            # 1 — быстро (greedy), 5 — точнее
# WHISPER_LOG_LEVEL=INFO

# --- Дисклеймер и викторина (бот не пускает к сценарию без принятия) ---
# Пусто DISCLAIMER_VERSION - блок отключен. Увеличь число - все пользователи пройдут заново
# DISCLAIMER_SKIP=1 - только для разработки, в прод не включать
# DISCLAIMER_TEXT - HTML (валидный для Telegram HTML); вопрос ниже - plain, экранируется в коде
# DISCLAIMER_VERSION=1
# DISCLAIMER_SKIP=0
# DISCLAIMER_TEXT="Бот дает автоматическую подсказку по фото работы и материалам ГДЗ. Это не оценка учителя и не замена проверки в школе. Решение и оценку задания определяет учитель. Ответы модели могут содержать ошибки - сверяйтесь с учебником и разбором. Продолжая, вы подтверждаете, что используете бота добросовестно и не передаете чужие персональные данные без согласия."
# DISCLAIMER_QUIZ_QUESTION="Что из перечисленного верно про проверку домашней работы этим ботом?"
# Индекс верного варианта 0..3 по номеру OPT (DISCLAIMER_QUIZ_OPT_1 -> 1), не «первая кнопка = 1»
# После смены верного индекса или текстов вариантов увеличь DISCLAIMER_VERSION - иначе старые кнопки в чате не совпадут с конфигом
# DISCLAIMER_QUIZ_CORRECT=1
# DISCLAIMER_QUIZ_OPT_0="Бот выставляет официальную отметку в школе"
# DISCLAIMER_QUIZ_OPT_1="Это подсказка; итоговую оценку дает учитель"
# DISCLAIMER_QUIZ_OPT_2="Модель никогда не ошибается"
# DISCLAIMER_QUIZ_OPT_3="Можно не сверяться с учебником"
# Текст второй inline-кнопки (до 64 символов); пусто - в коде «Принимаю условия»
# DISCLAIMER_ACCEPT_BUTTON=

# Прокси только для Telegram Bot API (polling, get_me), если с хоста недоступен api.telegram.org
# Примеры: http://user:pass@host:3128  или  socks5://127.0.0.1:1080 (для SOCKS: pip install "httpx[socks]")
# TELEGRAM_PROXY=

# Наборы стикеров после проверки (имена из URL t.me/addstickers/ИМЯ, через запятую). Общий список для награды 50%+ и мотивации 0%; порядок наборов при отправке случайный. Пусто — встроенный пул в bot.py (тот же состав, что ниже)
STICKER_SET_POOL=Komnata_lomki,NBstickeriaBrat,VikostVSpack,ShadowKitty,taxiderm,DonutTheDog,HotCherry,UtyaDuck

# Переопределить только награду (50%+) или только мотивацию (0% / смешанные числа):
# TADA_STICKER_SET_NAMES=MyRewardPack
# MOTIVATION_STICKER_SET_NAMES=MyMotivationPack

# TEI (Text Embeddings Inference): тональность и эмоции текста из /support и замечания по дизлайку проверки
# Оба ключа необязательны; пусто - анализ не вызывается. Базовый URL без завершающего /
# Контракт: POST {base}/predict, тело JSON {"inputs":"текст","truncate":true} (как у HF TEI)
# Исходящие запросы бота к TEI идут через httpx с резолвом IPv4 (меньше сбоев DNS в Docker)
# Если бот в Docker, а TEI на хосте - не используй localhost (это сеть контейнера); имя сервиса compose или host.docker.internal
# TEI_SENTIMENT_URL=http://localhost:8081
# TEI_EMOTION_URL=http://localhost:8082

# URL сервера проверки (для бота), без завершающего /
# Локально: http://localhost:8000
# Продакшен за Nginx с префиксом (не перекрывает сайт на /): https://ВАШ_ДОМЕН/tgzh-api
# Docker Compose: у tgzh-bot в docker-compose.yml задано SERVER_URL=http://tgzh-server:8000 (перекрывает .env в контейнере). Не копируй tgzh-server в .env для запуска бота НА ХОСТЕ — на хосте это имя не резолвится (Ошибка связи / Errno -3). Локально без Docker: SERVER_URL=http://127.0.0.1:8000
# Не оставляй пустую строку SERVER_URL= — getenv не подставит дефолт; бот подставит http://localhost:8000 и в Docker лучше явно задать URL в compose
SERVER_URL=http://localhost:8000

# Порт сервера
PORT=8000

# Тестовый режим AI (1 = заглушка; 0 = VLLM при заданном VLLM_BASE_URL)
AI_MOCK=1

# VLLM (OpenAI-совместимый /v1/chat/completions, vision Qwen3-VL)
# Допустимо полный URL до chat/completions — в коде обрежется до .../v1
VLLM_BASE_URL=http://vllm.example.internal:54321/v1/chat/completions
VLLM_API_KEY=1
VLLM_MODEL=qwen/qwen3-vl-8b
# VL: 1/0 явно. Пусто — по имени модели (подстрока vl или vision).
# Qwen 3 8b / 3.5 9b в LM Studio обычно без зрения: VLLM_VISION=0
# VLLM_VISION=
# Временный backend LM Studio (потом vLLM +, тот же OpenAI-контракт):
# VLLM_BASE_URL=http://host.docker.internal:1234/v1
# Имя модели подставляется в конец ответа проверки и сводки (строка «Модель: …»); в AI_MOCK=1 в скобках «тестовый режим»
# Контекст модели (документация); на длину ответа влияет VLLM_MAX_TOKENS
VLLM_CONTEXT_WINDOW=32768
VLLM_MAX_TOKENS=4096
# Qwen3: выключить thinking — суффикс /no_think в тексте и extra_body chat_template_kwargs для vLLM. 0 = не добавлять
VLLM_NO_THINK=1

# --- Опциональный fallback на альтернативный OpenAI-совместимый эндпоинт ---
# Срабатывает только если primary VLLM упал (APIConnectionError, 5xx/408/429,
# таймаут, пустые choices). Не для постоянной нагрузки — cursor-bridge медленный.
# Включить (0/1):
VLLM_FALLBACK_ENABLE=0
# Адрес fallback (например, OpenAI-эндпоинт cursor-bridge):
# VLLM_FALLBACK_BASE_URL=http://bridge.example.internal:8787/v1
# Bearer-токен — должен совпадать с BRIDGE_OPENAI_API_KEY в bridge:
# VLLM_FALLBACK_API_KEY=
# Имя модели для fallback — поле OpenAI `model`, которое бот шлёт в каждом запросе
# к bridge. ЕСЛИ конкретный bridge маппит это в `cursor-agent --model <slug>` —
# выбирай слаг Cursor CLI: `composer-2`, `gpt-5`, `gpt-5-codex`, `claude-sonnet-4`,
# `claude-sonnet-4-thinking`, `auto`. Если bridge игнорирует поле (как минимальные
# реализации поверх голого `cursor-agent`) — значение остаётся только в логах,
# реальная модель определяется тем, как bridge запускает agent.
# По умолчанию ставим composer-2 — на bridge'ах с маппингом это даст быструю
# Cursor-родную модель.
VLLM_FALLBACK_MODEL=composer-2
# Таймаут одного запроса к fallback (секунды); cursor-agent медленный:
# VLLM_FALLBACK_TIMEOUT_SEC=180
# Таймауты httpx-клиента бота на POST /check (секунды). Cursor-фолбэк бывает >120 с
# на одно фото, дефолт 360. Для основной модели (qwen) хватает 120. Должны быть
# заметно больше VLLM_FALLBACK_TIMEOUT_SEC, иначе клиент отвалится по таймауту,
# когда сервер ещё ждёт ответ Cursor:
# BOT_CHECK_TIMEOUT_AUTO_SEC=120
# BOT_CHECK_TIMEOUT_CURSOR_SEC=360
# Источники IP для VLLM_FALLBACK_BASE_URL (когда системный DNS отдает протухший адрес).
# Приоритет: HTTP-echo > UDP-DNS > системный резолвер.
#
# 1) HTTP-echo сервис, отдающий публичный IP клиента в plain text (например no-ip).
#    Применим, когда bridge стоит за тем же NAT, что и контейнер: WAN-IP клиента
#    == адрес, по которому bridge виден извне. Самый авторитетный источник:
#    минует кеши публичных DNS. Пусто — не используется.
# VLLM_FALLBACK_RESOLVE_HTTP_ECHO_URL=http://http-echo.example.com
# 2) Upstream DNS-сервера (CSV, IPv4) для UDP-резолва, минуя /etc/resolv.conf.
#    Используются как запасной путь, если HTTP-echo недоступен (или вместо него).
# VLLM_FALLBACK_DNS_SERVERS=1.1.1.1,8.8.8.8

# --- Предварительное OCR (опционально, сервис tgzh-preocr в Docker, профиль preocr) ---
# Пусто PREOCR_URL — сервер не вызывает preocr; изображение уходит в VLM как сейчас
# В compose после: docker compose --profile preocr up -d --build — задай PREOCR_URL=http://tgzh-preocr:8088
# По умолчанию сборка CPU (Dockerfile.preocr) — работает на любой машине без CUDA. Для GPU создай docker-compose.override.yml
# с PREOCR_DOCKERFILE=Dockerfile.preocr.gpu и блоком "gpus: all" у tgzh-preocr (см. README).
# PaddlePaddle 3.2.2 поддерживает sm_75…90; на sm_120 (Blackwell, RTX 50xx) — пока только CPU.
# PREOCR_DOCKERFILE=Dockerfile.preocr
# PADDLE_GPU_IMAGE=paddlepaddle/paddle:3.2.2-gpu-cuda12.6-cudnn9.5
# PREOCR_URL=
# Таймаут HTTP к preocr (секунды); первый запрос может долго качать модели
# PREOCR_TIMEOUT_SEC=120
# Максимум символов распознанного текста во вступлении к промпту VLM
# PREOCR_PROMPT_MAX_CHARS=8000
# Шаблон блока перед основным промптом; плейсхолдер {body} — merged_markdown из API
# VLLM_PROMPT_PREOCR_BLOCK=
# В контейнере preocr: ocr (быстро, строки текста ru) | structure (PP-StructureV3: формулы LaTeX, диаграммы; тяжелее)
# PREOCR_PIPELINE=ocr
# Язык распознавания PaddleOCR (кириллица: ru)
# PREOCR_OCR_LANG=ru
# Длинная сторона изображения перед детекцией (согласовано с уменьшением фото в боте, по умолчанию 1024)
# PREOCR_MAX_SIDE=1024

# Промпт проверки для LLM (скопируй в .env и правь). Плейсхолдеры: {book}, {g}, {anchor}
# Если VLLM_CHECK_HOMEWORK пусто - используется VLLM_CHECK_HOMEWORK_DEFAULT; если и оно пусто - встроенный шаблон в ai_checker.py
VLLM_CHECK_HOMEWORK="Учебник (ориентир): {book} ({g}).
Пользователь указал задание: {anchor} (номера как в оглавлении/разметке на gdz.ru или в учебнике).

По изображению: распознай ответ ученика на листе. Сверь с тем, что ожидается для этого задания (параграф + упражнение или параграф + страница проверочной работы).

Для проверочных заданий (когда в привязке указана страница проверочной): не считай ошибкой отсутствие развернутого письменного решения. Допустимы короткие ответы: да, нет, одно слово или число - если это соответствует формулировке задания.

Для любых заданий: опиши существенные ошибки и что сделано верно. Не используй отдельный блок или заголовок Вывод (в том числе в markdown **Вывод:**) - пиши связным текстом без итогового абзаца с такой пометкой.

По каждому заданию пиши РОВНО ОДНУ строку-пункт списка (- Задание N: ...), максимум 1-2 коротких предложения. Не разворачивай разбор одного задания в несколько пунктов и не повторяй одно и то же замечание разными словами.

Если на фото другое задание - явно напиши об этом. Пиши по-русски."

# Дополнительные промпты (пусто = встроенный текст в ai_checker.py). Плейсхолдеры:
# VLLM_PROMPT_MIXED_NUMBERS - в конце метка: {marker} или {MARKER} (подставится [tgzh_mixed_numbers])
# VLLM_PROMPT_TEXT_FILE - {instruction}, {file_body}
# VLLM_PROMPT_QUIP - {excerpt} (плейсхолдер {percent} в кастомном шаблоне дает пустую строку)
# VLLM_PROMPT_IGNORE_GDZ (игнор водяных gdz.ru / гдз.ру на фото), VLLM_PROMPT_RESPONSE_FORMAT, VLLM_PROMPT_RESPONSE_FORMAT_REMINDER
#   - встроенный VLLM_PROMPT_RESPONSE_FORMAT требует РОВНО одну строку-пункт по каждому заданию (1-2 предложения),
#     запрещает дублировать замечания разными словами и зацикливаться; см. дефолт в ai_checker.py
#   - дополнительная страховка от петель: дубликаты строк и повторные пункты по одному и тому же «Задание N» автоматически
#     срезаются после ответа модели (homework_check_status.dedupe_homework_check_lines)
# VLLM_PROMPT_MULTI_SUMMARY_INTRO - вводная для сводки (если VLLM_CHECK_MULTI_SUMMARY пусто; плюс напоминание оформления из REMINDER)
# VLLM_PROMPT_MULTI_SUMMARY_COVERAGE - полнота заданий по альбому (сводка нескольких фото); вставляется и при непустом VLLM_CHECK_MULTI_SUMMARY
# VLLM_PROMPT_GDZ_CHECKLIST - {exercises}, {verif_pages}, {verif_works} — сверка с оглавлением; кастом без {verif_works} — совместимость со старым шаблоном; VLLM_PROMPT_GDZ_CHECKLIST_FALLBACK — если списки и работы пусты
# VLLM_PROMPT_GDZ_TASK_CONDITION - {condition} — условие для сверки; по умолчанию модель не дублирует его в тексте (ученик видит условие в том же сообщении от бота); VLLM_GDZ_TASK_CONDITION_MAX_CHARS — обрезка в промпт (по умолчанию 6000)
# VLLM_QUIP_MOCK_TEXT - ответ quip при AI_MOCK=1; VLLM_QUIP_FALLBACK - если модель вернула пусто
# VLLM_MSG_DOC_UNSUPPORTED, VLLM_MSG_UNSUPPORTED_MIME ({mime}), VLLM_MSG_EMPTY_MODEL_REPLY, VLLM_MSG_EMPTY_SUMMARY
# VLLM_CHECK_HOMEWORK_DEFAULT - шаблон как VLLM_CHECK_HOMEWORK, если основной ключ пустой

# Рубрикатор ответа (формат, существенные ошибки). Пусто - к заданию рубрика не дописывается. Блок Вывод в промпт не включаем.
VLLM_CHECK_RUBRIC="Формат ответа и критерии:

- Заголовка **Вывод:** и отдельного итогового абзаца с таким названием не используй.
- В разделе про ошибки перечисляй только существенное: неверные вычисления, неверный ход, неверный ответ, явное несоответствие условию задачи. Не оформляй как ошибки: отсутствие явно выписанного шага, если числовой результат и ход при этом верны; замечания о порядке действий только потому, что он не назван словами, если из записи порядок следует; мелкие стилистические замечания без влияния на правильность.
- Для проверочных заданий не трактуй как отсутствие решения короткий ответ (да, нет, число), если он уместен по условию.
- Если ответ численно верен, но запись неполная с учебной точки зрения, не раздувай раздел про ошибки; при отсутствии существенных ошибок засчитывай ответ как верный.
- Если существенных ошибок нет, раздел про ошибки сделай очень коротким или напиши, что существенных ошибок нет."

# Сводка при нескольких фото за раз (второй вызов LLM, только текст). Плейсхолдеры: {parts} — блок с результатами по каждому фото, {n} — число фото. Пусто — встроенный шаблон в ai_checker.py
# VLLM_CHECK_MULTI_SUMMARY=

# База SQLite с выбранным учебником и глобальной статистикой (создается автоматически), если не задан DATABASE_URL
USER_DB_PATH=data/users.sqlite

# Опционально PostgreSQL вместо SQLite (asyncpg не требуется — используется psycopg, синхронно)
# DATABASE_URL=postgresql://tgzh:tgzh@localhost:5432/tgzh

# Креды/имя БД для контейнера postgres в docker-compose.yml (фоллбэки tgzh/tgzh/tgzh).
# Менять обязательно для прод-деплоя; держи такие же значения в DATABASE_URL.
# POSTGRES_USER=tgzh
# POSTGRES_PASSWORD=tgzh
# POSTGRES_DB=tgzh

# Prometheus: положительный порт — HTTP /metrics на METRICS_BIND (по умолчанию 0.0.0.0) в bot.py и server.py
# METRICS_PORT=9109
# METRICS_BIND=127.0.0.1

# Часовой пояс границы учебного года для статистики (1 сен — 31 авг следующего года).
# Compose в docker-compose.yml для tgzh-bot подставляет ${STATS_TIMEZONE:-Europe/Moscow}.
# STATS_TIMEZONE=Europe/Moscow

# Каталог учебников для бота (генерация: python3 scripts/fetch_gdz_textbooks.py)
GDZ_CATALOG_PATH=data/gdz_matematika_textbooks.json

# Кеш готовых решений gdz.ru (условие + картинки); повторные «Показать ГДЗ» без запросов к сайту
GDZ_CACHE_DIR=data/gdz_cache

# Сколько кнопок параграфа §1…§N максимум (по умолчанию 48, в коде зажато 6–100)
# GDZ_PARAGRAPH_BUTTONS_MAX=48

# Кеш результата разбора оглавления учебника для числа N (секунды)
# GDZ_PARAGRAPH_INDEX_CACHE_SEC=3600

# Если из оглавления не извлеклись номера упражнений параграфа — верхняя граница для клавиатуры «Упражнение кнопками» (1..N)
# GDZ_EXERCISE_KEYPAD_FALLBACK_MAX=999

# Максимум кнопок «стр.N» проверочных на шаге 2; 0 — не обрезать (риск лимита Telegram ~100 кнопок на клавиатуру)
# GDZ_VERIF_BUTTONS_MAX=96

# Хаб motok (person_id + JWT). Пустой MOTOK_HUB_URL — бот работает как раньше, без JWT.
# MOTOK_HUB_URL=http://192.168.0.10:54326
# MOTOK_INTERNAL_TOKEN=
# MOTOK_HUB_TOKEN_SECRET=
# На tgzh-server тот же MOTOK_HUB_TOKEN_SECRET: если задан, POST /check требует Bearer.

# --- Деплой на VPS (переменные только на машине, откуда запускаешь scripts/deploy-docker.sh; в контейнеры не попадают) ---
# export DEPLOY_HOST=user@hostname
# Каталог на сервере (по умолчанию ~/tgzh-docker на удалённом хосте)
# export DEPLOY_REMOTE_PATH=/home/user/tgzh-docker
# Профиль Compose, например preocr для сервиса tgzh-preocr (иначе скрипт поднимает только postgres, tgzh-server, tgzh-bot)
# export DEPLOY_COMPOSE_PROFILE=preocr
# После up выполнить миграции в контейнере бота (нужен DATABASE_URL на сервере)
# export DEPLOY_RUN_ALEMBIC=1
