FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY server.py ai_checker.py image_gen.py photo_check.py photo_prepare.py preocr_client.py logging_config.py tgzh_metrics.py homework_check_status.py tgzh_httpx.py motok_jwt.py bot_stats.py tgzh_db.py ./

EXPOSE 8000

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
