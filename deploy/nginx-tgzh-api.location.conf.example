# Фрагмент для существующего server { listen 443 ssl; ... } того же server_name, что и сайт
# Не трогает корень сайта: только префикс /tgzh-api/ уходит в tgzh-server на localhost:8000
#
# Подключение: скопируй блок location в свой vhost или include из snippets;
# затем: nginx -t && systemctl reload nginx
#
# Бот дергает POST .../tgzh-api/check, GET .../tgzh-api/health

location /tgzh-api/ {
    proxy_pass http://127.0.0.1:8000/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    client_max_body_size 25m;
    proxy_read_timeout 300s;
    proxy_connect_timeout 60s;
    proxy_send_timeout 300s;
}
